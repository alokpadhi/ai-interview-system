# LLM Provider (Ollama, OpenAI, anthropic)
LLM_PROVIDER=ollama

# Ollama configuaration (LLM Provier=Ollama)
OLLAMA_BASE_URL=
OLLAMA_MODEL=
OLLAMA_MODEL_SECONDARY=

# OpenAI configuration (LLM Proiver=OpenAI)
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_MODEL_SECONDARY=

# Anthropic configuration (LLM Provider=Anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_MODEL_SECONDARY=

# Embedding model (supports only through huggingface/sentence-transformer)
EMBEDDING_MODEL=

# Database paths
VECTOR_DB_PATH=data/vector_db
SQLITE_DB_PATH=data/sqlite/interviews.db
CHECKPOINT_DB=data/checkpointer.db

# Observability
LANGCHAIN_TRACING_V2=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-interview-system

# logging
LOG_LEVEL=INFO